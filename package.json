{
  "name": "quicky-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quicky — pure Next.js webapp. 8 tiles for travelers in Thailand. Real APIs (Convex → Open-Meteo, Overpass, Nominatim) — no mocks.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "test:ci": "vitest run --coverage && playwright test"
  },
  "dependencies": {
    "convex": "^1.0.0",
    "exifr": "^7.1.3",
    "next": "^16.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "eslint": "^9.0.0",
    "happy-dom": "^15.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
